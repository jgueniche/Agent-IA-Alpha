# =============================================================================
# Alpha Imagerie — variables d'environnement (modele)
# Copier en `.env` et remplir. NE JAMAIS commiter de `.env` rempli.
# Aucune valeur reelle de production ne doit figurer dans ce fichier.
# =============================================================================

# -----------------------------------------------------------------------------
# Donnees / infrastructure
# -----------------------------------------------------------------------------
# Postgres (heberge sur infra HDS en production : OVHcloud HDS / Scaleway HDS)
POSTGRES_USER=alpha
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=alpha_imagerie
# URL utilisee par core-api (dans Docker : host = "postgres")
DATABASE_URL=postgresql://alpha:change_me_in_real_env@postgres:5432/alpha_imagerie?schema=public

# Redis (files de jobs / relances)
REDIS_URL=redis://redis:6379

# Cle de chiffrement applicatif des champs sensibles (AES-256-GCM).
# 32 octets encodes en base64. Generer : `openssl rand -base64 32`
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Auth / securite (core-api)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900          # secondes (15 min)
JWT_REFRESH_TTL=604800      # secondes (7 jours)
# OIDC (optionnel en Phase 0, brancher un IdP en prod)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# MFA obligatoire pour les secretaires (TOTP)
MFA_REQUIRED=true

# core-api
CORE_API_PORT=4000
CORE_API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Compte admin initial cree par le seed (Phase 0 uniquement, a changer)
SEED_ADMIN_EMAIL=admin@alpha-imagerie.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin2026

# Cle partagee service-a-service (voice-gateway -> core-api, ingestion appels).
# Generer : `openssl rand -hex 32`
SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Back-office (Next.js)
# -----------------------------------------------------------------------------
BACK_OFFICE_PORT=3000
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Conformite / retention (RGPD / HDS)
# -----------------------------------------------------------------------------
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=1825   # 5 ans (a confirmer avec le DPO)
RECORDING_ENABLED=false         # enregistrement conditionne au consentement

# -----------------------------------------------------------------------------
# Telephonie (Phase 2 — 3CX self-hosted / private-cloud)
# -----------------------------------------------------------------------------
SIP_TRUNK_HOST=
SIP_USERNAME=
SIP_PASSWORD=
AGENT_EXTENSION=
TRANSFER_TARGET_EXTENSION=

# -----------------------------------------------------------------------------
# Passerelle voix (Phase 1)
# -----------------------------------------------------------------------------
# URL de core-api vue depuis la voice-gateway (dans Docker : http://core-api:4000)
CORE_API_URL=http://core-api:4000
VOICE_GATEWAY_PORT=8080

# -----------------------------------------------------------------------------
# IA — interfaces interchangeables (Phase 1+). Cibles EEE / auto-hebergees.
# `mock` = providers hors-ligne (tests / simulate_call) ; sinon renseigner *_ENDPOINT.
# -----------------------------------------------------------------------------
STT_PROVIDER=faster-whisper      # whisper auto-heberge (ou "mock")
STT_ENDPOINT=
LLM_PROVIDER=mistral             # cible souveraine EEE
LLM_ENDPOINT=
LLM_API_KEY=
TTS_PROVIDER=piper               # ou XTTS auto-heberge
TTS_ENDPOINT=
TTS_VOICE_FR=fr_FR-female

# -----------------------------------------------------------------------------
# Agenda (Phase 4 — abstraction Doctolib)
# -----------------------------------------------------------------------------
CALENDAR_PROVIDER=ical           # ical | doctolib_partner
ICAL_FEED_URL_CERGY=
ICAL_FEED_URL_GOUSSAINVILLE=
# Renseigne uniquement si accreditation partenaire Doctolib obtenue
DOCTOLIB_PARTNER_CLIENT_ID=
DOCTOLIB_PARTNER_SECRET=

# -----------------------------------------------------------------------------
# Relances multicanal (Phase 6 — fournisseurs EEE / FR)
# -----------------------------------------------------------------------------
WHATSAPP_BSP_TOKEN=
WHATSAPP_ENDPOINT=            # endpoint BSP EEE (ex. 360dialog) ; vide = mode simule
SMS_GATEWAY_KEY=
SMS_ENDPOINT=                 # passerelle SMS FR ; vide = mode simule
# Fenetre d'envoi autorisee + jours (ISO 1=lundi..7=dimanche)
FOLLOWUP_HOURS_START=8
FOLLOWUP_HOURS_END=20
FOLLOWUP_DAYS=1,2,3,4,5,6
# File BullMQ (Redis) : true en production pour le traitement periodique
FOLLOWUPS_QUEUE_ENABLED=false
FOLLOWUP_DISPATCH_INTERVAL_MS=60000
